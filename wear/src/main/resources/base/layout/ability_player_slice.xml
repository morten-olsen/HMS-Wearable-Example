<?xml version="1.0" encoding="utf-8"?>
<DirectionalLayout
    xmlns:ohos="http://schemas.huawei.com/res/ohos"
    ohos:height="match_parent"
    ohos:width="match_parent"
    ohos:orientation="vertical"
    ohos:padding="10vp"
    ohos:alignment="center">

    <Image
        ohos:id="$+id:player_cover_art"
        ohos:height="80vp"
        ohos:width="80vp"
        ohos:scale_mode="stretch"
        ohos:layout_alignment="horizontal_center"/>

    <Text
        ohos:id="$+id:player_title"
        ohos:height="wrap_content"
        ohos:width="match_parent"
        ohos:text_size="16fp"
        ohos:text_alignment="center"
        ohos:top_margin="10vp"
        ohos:max_lines="2"/>

    <Slider
        ohos:id="$+id:player_progress"
        ohos:height="wrap_content"
        ohos:width="match_parent"
        ohos:top_margin="10vp"
        ohos:min_value="0"/>

    <DirectionalLayout
        ohos:height="wrap_content"
        ohos:width="match_parent"
        ohos:orientation="horizontal">
        <Text
            ohos:id="$+id:player_current_time"
            ohos:height="wrap_content"
            ohos:width="0vp"
            ohos:weight="1"
            ohos:text_size="12fp"
            ohos:text_alignment="left"
            ohos:text="00:00"/>
        <Text
            ohos:id="$+id:player_total_time"
            ohos:height="wrap_content"
            ohos:width="0vp"
            ohos:weight="1"
            ohos:text_size="12fp"
            ohos:text_alignment="right"
            ohos:text="00:00"/>
    </DirectionalLayout>

    <Button
        ohos:id="$+id:player_play_pause_button"
        ohos:height="wrap_content"
        ohos:width="match_content"
        ohos:text="Play"
        ohos:layout_alignment="horizontal_center"
        ohos:top_margin="10vp"/>

    <!-- Add other controls like skip if needed -->

</DirectionalLayout>
